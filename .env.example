# ---------------------------------------------------------------------------
# Cozy Tops — environment configuration
#
# There are NO silent fallbacks. Each stage requires its configuration and
# fails loudly (with a clear message in the UI) when it's missing, instead of
# quietly serving sample data as if it were real.
#
# Minimum for a live deployment: OPENAI_API_KEY + INSTAGRAM_PROVIDER=apify
# with an APIFY_TOKEN.
# ---------------------------------------------------------------------------

# --- OpenAI (one key powers everything) --------------------------------------
# Required. Used for: style analysis (GPT vision over real post photos),
# design-brief authoring, and photorealistic garment imagery (gpt-image-2).
OPENAI_API_KEY=

# Text + vision reasoning model for analysis + design briefs.
OPENAI_TEXT_MODEL=gpt-4.1

# --- Instagram data source ----------------------------------------------------
# REQUIRED — there is no default. Unset => /api/analyze fails loudly.
#   apify  -> licensed third-party data vendor; fetches a public handle's real
#             posts (requires APIFY_TOKEN from apify.com; usage-based pricing)
#   graph  -> official Instagram Graph API; ONLY works for accounts that have
#             OAuth-authorized YOUR app (cannot read arbitrary public handles)
#   demo   -> explicitly opt in to bundled sample personas; every response is
#             labeled "Demo persona / sample data", never presented as real
INSTAGRAM_PROVIDER=apify
INSTAGRAM_GRAPH_TOKEN=
APIFY_TOKEN=

# --- Fulfillment / manufacturing backend --------------------------------------
# demo (default) returns a clearly-labeled SIMULATED confirmation; a configured
# real partner that fails produces an error, never a fake success.
#   printful -> Printful print-on-demand API
#   shopify  -> Shopify storefront / Admin API
FULFILLMENT_PROVIDER=demo
PRINTFUL_API_KEY=
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_TOKEN=

# --- Photorealistic imagery ----------------------------------------------------
# Uses OPENAI_API_KEY above. gpt-image-2 is a "protected" model: your OpenAI org
# must be VERIFIED (platform.openai.com → Settings → Organization → Verify) or
# the API returns 403.
IMAGE_PROVIDER=openai
OPENAI_IMAGE_MODEL=gpt-image-2
# Image quality / cost trade-off: low | medium | high | auto
IMAGE_QUALITY=high
# Generation runs via the Responses API in background mode (start + poll), so a
# 100-150s high-quality render never blocks a single request — it works within
# serverless time limits (no Vercel Pro needed). This cheap model drives the
# image tool; any tool-capable model works.
OPENAI_ORCHESTRATOR_MODEL=gpt-4.1-mini

# --- App -----------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=Cozy Tops

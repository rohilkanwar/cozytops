# ---------------------------------------------------------------------------
# Cozy Tops — environment configuration
#
# There are NO silent fallbacks. Each stage requires its configuration and
# fails loudly (with a clear message in the UI) when it's missing, instead of
# quietly serving sample data as if it were real.
#
# Minimum for a live deployment: OPENAI_API_KEY + INSTAGRAM_PROVIDER=apify
# with an APIFY_TOKEN.
# ---------------------------------------------------------------------------

# --- OpenAI (one key powers everything) --------------------------------------
# Required. Used for: style analysis (GPT vision over real post photos),
# design-brief authoring, and photorealistic garment imagery (gpt-image-2).
OPENAI_API_KEY=

# Text + vision reasoning model for analysis + design briefs.
OPENAI_TEXT_MODEL=gpt-4.1

# --- Instagram: PUBLIC handles ("type any @handle") ---------------------------
# Governs the public-handle box. No default: unset => that path fails loudly.
#   apify -> licensed data vendor; fetches a public handle's real posts
#            (APIFY_TOKEN from apify.com; usage-based pricing)
#   demo  -> explicitly opt in to bundled sample personas; every response is
#            labeled "sample data", never presented as real
INSTAGRAM_PUBLIC_PROVIDER=apify
APIFY_TOKEN=

# --- Instagram: CONNECT (OAuth self-connect, private accounts) ----------------
# Lets a visitor authorize reading THEIR OWN account (public or private) with a
# short-lived, session-only token — never persisted, never someone else's data.
# Requires a Meta developer app with Instagram Login + App Review for the
# scopes. When CLIENT_ID + CLIENT_SECRET are set, a "Connect your Instagram"
# button appears. Endpoint/scope defaults track Instagram Login; override if
# your app uses a different product.
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
# Must EXACTLY match a redirect URI registered on the Meta app, e.g.
# https://your-domain.com/api/auth/instagram/callback . If blank, derived from
# the request origin at runtime.
INSTAGRAM_REDIRECT_URI=
# Advanced overrides (optional):
# INSTAGRAM_OAUTH_SCOPES=instagram_business_basic
# INSTAGRAM_OAUTH_AUTH_URL=https://www.instagram.com/oauth/authorize
# INSTAGRAM_OAUTH_TOKEN_URL=https://api.instagram.com/oauth/access_token
# INSTAGRAM_GRAPH_BASE=https://graph.instagram.com

# --- Fulfillment / manufacturing backend --------------------------------------
# demo (default) returns a clearly-labeled SIMULATED confirmation; a configured
# real partner that fails produces an error, never a fake success.
#   printful -> Printful print-on-demand API
#   shopify  -> Shopify storefront / Admin API
FULFILLMENT_PROVIDER=demo
PRINTFUL_API_KEY=
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_TOKEN=

# --- Photorealistic imagery ----------------------------------------------------
# Uses OPENAI_API_KEY above. gpt-image-2 is a "protected" model: your OpenAI org
# must be VERIFIED (platform.openai.com → Settings → Organization → Verify) or
# the API returns 403.
IMAGE_PROVIDER=openai
OPENAI_IMAGE_MODEL=gpt-image-2
# Image quality / cost trade-off: low | medium | high | auto
# Spend follows attention: option-card thumbnails render at
# IMAGE_PREVIEW_QUALITY (~$0.06/img at medium); the full 3-shot set renders at
# IMAGE_QUALITY (~$0.17-0.25/img at high) ONLY for the design the visitor
# selects. Typical session ≈ $1/garment instead of ~$3 for eager-everything.
IMAGE_QUALITY=high
IMAGE_PREVIEW_QUALITY=medium
# Generation runs via the Responses API in background mode (start + poll), so a
# 100-150s high-quality render never blocks a single request — it works within
# serverless time limits (no Vercel Pro needed). This cheap model drives the
# image tool; any tool-capable model works.
OPENAI_ORCHESTRATOR_MODEL=gpt-4.1-mini

# --- Affiliate marketing ("Shop the vibe") --------------------------------------
# Style-matched picks deep-link into real retailers. Recommendations render
# either way; these credentials monetize the outbound links (and switch on the
# FTC disclosure line in the UI).
#
# Amazon Associates tracking tag (affiliate-program.amazon.com), e.g.
# "cozytops-20". Appended to Amazon links as &tag=.
AMAZON_ASSOCIATE_TAG=
# Skimlinks publisher site id (skimlinks.com). Wraps non-Amazon merchant links
# via go.skimresources.com so ~48k retailers (Nordstrom, Etsy, ASOS, ...) pay
# out through one account.
SKIMLINKS_SITE_ID=

# --- App -----------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=Cozy Tops

# ---------------------------------------------------------------------------
# Cozy Tops — environment configuration
#
# Everything is OPTIONAL. With no keys set, the app runs in fully self-contained
# DEMO MODE: curated sample Instagram personas, a heuristic style analyzer, and
# locally-rendered SVG garment mockups. Add keys to progressively light up the
# real pipeline.
# ---------------------------------------------------------------------------

# --- Claude (vision + style synthesis + design brief) ----------------------
# When set, the analyzer uses Claude for multimodal reasoning and the design
# generator uses Claude to author the garment brief. Without it, a deterministic
# heuristic fallback is used so the experience still works.
ANTHROPIC_API_KEY=

# Model used for analysis + design. Defaults to a current Claude model.
CLAUDE_MODEL=claude-opus-4-8

# --- Instagram data source --------------------------------------------------
# Which provider supplies a handle's public posts.
#   demo   -> curated sample personas bundled with the app (default)
#   graph  -> Instagram Graph API (requires an app + user-authorized token;
#             only works for accounts that have authorized your app)
#   apify  -> a licensed third-party scraping/data provider (token below)
INSTAGRAM_PROVIDER=demo
INSTAGRAM_GRAPH_TOKEN=
APIFY_TOKEN=

# --- Fulfillment / manufacturing backend -----------------------------------
# Who actually prints + ships the garment.
#   demo     -> simulated order confirmation (default)
#   printful -> Printful print-on-demand API
#   shopify  -> Shopify storefront / Admin API
FULFILLMENT_PROVIDER=demo
PRINTFUL_API_KEY=
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_TOKEN=

# --- App ---------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=Cozy Tops
